{
  "name": "quotabuddy",
  "version": "0.1.0",
  "description": "Pixel desktop pets that show how much Claude Code / Codex quota you have left.",
  "homepage": "https://github.com/Traveller2001/QuotaBuddy",
  "repository": {
    "type": "git",
    "url": "https://github.com/Traveller2001/QuotaBuddy.git"
  },
  "author": "Traveller2001",
  "license": "MIT",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && electron .",
    "demo": "node scripts/build.mjs && electron . --demo",
    "typecheck": "tsc --noEmit -p .",
    "test": "node scripts/build.mjs --tests && node --test \"dist-test/*.test.js\"",
    "dist": "node scripts/build.mjs && electron-builder",
    "dist:win": "node scripts/build.mjs && electron-builder --win",
    "dist:mac": "node scripts/build.mjs && electron-builder --mac",
    "dist:linux": "node scripts/build.mjs && electron-builder --linux"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "smol-toml": "^1.9.1",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "io.github.traveller2001.quotabuddy",
    "productName": "QuotaBuddy",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "assets/**",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "icon": "build/icon.png"
    }
  }
}
